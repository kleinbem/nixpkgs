ggml-cpu: skip the SME variants when the compiler lacks SME

GGML_CPU_ALL_VARIANTS on Linux/aarch64 always adds the armv9.2 variants,
whose -march ends in +sme. GCC 13 rejects that ("invalid feature modifier
'sme'"), so the whole build fails on toolchains that are still on GCC 13,
e.g. anything built with the CUDA 12 host compiler. Probe the compiler and
leave those two variants out when it does not support SME, like the
PowerPC and s390x blocks already do for their newest ISA levels.

Upstream issue: https://github.com/ggml-org/llama.cpp/issues/17403
---
 ggml/src/CMakeLists.txt | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -527,8 +527,15 @@ if (GGML_CPU_ALL_VARIANTS)
             ggml_add_cpu_backend_variant(armv8.2_3    DOTPROD FP16_VECTOR_ARITHMETIC SVE)
             ggml_add_cpu_backend_variant(armv8.6_1    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8)
             ggml_add_cpu_backend_variant(armv8.6_2    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SVE2)
-            ggml_add_cpu_backend_variant(armv9.2_1    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SME)
-            ggml_add_cpu_backend_variant(armv9.2_2    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SVE2 SME)
+            # SME needs GCC 14 / Clang 18; toolchains pinned to an older host
+            # compiler (CUDA 12 still caps GCC at 13) would fail the whole build.
+            check_cxx_compiler_flag("-march=armv9.2-a+sme" GGML_CXX_SUPPORTS_ARM_SME)
+            if (GGML_CXX_SUPPORTS_ARM_SME)
+                ggml_add_cpu_backend_variant(armv9.2_1    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SME)
+                ggml_add_cpu_backend_variant(armv9.2_2    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SVE2 SME)
+            else()
+                message(STATUS "Skipping the SME CPU backend variants: the compiler does not accept -march=armv9.2-a+sme")
+            endif()
         elseif (CMAKE_SYSTEM_NAME MATCHES "Android")
             # Android-specific backends with SoC-compatible feature sets
             ggml_add_cpu_backend_variant(android_armv8.0_1)
